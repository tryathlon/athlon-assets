/images/*
  Cache-Control: public, max-age=31536000, immutable

/vectors/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# No catch-all Cache-Control: Pages joins every matching rule's values, so a
# /* rule would append a second, conflicting directive to the immutable ones.
